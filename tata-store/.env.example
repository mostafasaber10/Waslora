TATA_STORE_ADMIN_EMAIL=your-admin-email@example.com
TATA_STORE_ADMIN_SETUP_TOKEN=replace-this-with-a-random-secret-at-least-32-characters-long
TATA_STORE_REQUIRE_APKSIGNER=true
# Full path inside the deployment to Android's apksigner executable.
TATA_STORE_APKSIGNER=
# Optional comma-separated SHA-256 certificate digests allowed for uploads.
TATA_STORE_ALLOWED_CERT_SHA256=
